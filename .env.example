# Local development: copy this file to .env.local and supply your own values.
# No built-in admin credentials exist. Use long, unique, randomly generated values.
# ADMIN_PASSWORD must contain at least 16 characters.
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET must contain at least 32 characters.
ADMIN_SESSION_SECRET=

# Required for persistent customer management on Vercel / in production.
# Use a Neon PostgreSQL connection string, including its SSL parameters.
# Without this value, development uses the local ignored data directory.
DATABASE_URL=
